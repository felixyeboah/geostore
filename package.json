{
	"name": "supastarter-nextjs",
	"private": true,
	"scripts": {
		"build": "dotenv -c -- turbo build",
		"db:generate": "pnpm --filter @repo/database generate",
		"db:push": "pnpm --filter @repo/database push",
		"db:seed": "pnpm --filter @repo/scripts seed:store",
		"db:up": "docker compose up -d postgres minio minio-setup",
		"dev": "dotenv -c -- turbo dev --concurrency 15",
		"type-check": "dotenv -c -- turbo type-check",
		"start": "dotenv -c -- turbo start",
		"lint": "biome lint",
		"check": "biome check --write",
		"clean": "turbo clean",
		"format": "biome format --write",
		"test:commerce": "tsx --test packages/commerce/cart.test.ts packages/commerce/order.test.ts packages/payments/lib/store-payments.test.ts packages/payments/lib/reevit-webhook.test.ts apps/marketing/modules/commerce/lib/order-token.test.ts packages/utils/lib/image-hosts.test.ts apps/saas/modules/admin/lib/overview.test.ts"
	},
	"engines": {
		"node": ">=20"
	},
	"packageManager": "pnpm@10.28.2",
	"devDependencies": {
		"@biomejs/biome": "catalog:",
		"@repo/tsconfig": "workspace:*",
		"@types/node": "catalog:",
		"dotenv-cli": "catalog:",
		"tsx": "catalog:",
		"turbo": "^2.8.17",
		"typescript": "catalog:"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"@prisma/client",
			"@prisma/engines",
			"@swc/core",
			"prisma",
			"prisma-zod-generator",
			"sharp"
		]
	}
}
