# Database
DATABASE_URL="YOUR_DATABASE_CONNECTION_STRING"
# For local development with Docker Compose:
# DATABASE_URL="postgresql://postgres:postgres@localhost:55432/geostore"
# ... if you use Supabase
DIRECT_URL=""

# App URLs (used for absolute URLs, sitemaps, auth callbacks, etc.)
NEXT_PUBLIC_MARKETING_URL="http://localhost:3001"
NEXT_PUBLIC_SAAS_URL="http://localhost:3000"

# Docs url
NEXT_PUBLIC_DOCS_URL="http://localhost:3001"

# Authentication
BETTER_AUTH_SECRET="A_RANDOM_SECRET_STRING"

# Signs the HMAC that lets a guest open their own order confirmation page.
# Kept separate from BETTER_AUTH_SECRET so that rotating sessions does not
# invalidate every order link already sitting in a customer's inbox.
# Falls back to BETTER_AUTH_SECRET when unset.
ORDER_TOKEN_SECRET=""
# During a rotation, set this to the previous ORDER_TOKEN_SECRET so links
# already in the wild keep resolving. Remove it once they have aged out.
ORDER_TOKEN_SECRET_PREVIOUS=""
# Set to "false" to stop honouring tokens minted with BETTER_AUTH_SECRET.
ORDER_TOKEN_ACCEPT_LEGACY=""

# Headers trusted to carry the client IP, comma separated. Leave unset to use
# cf-connecting-ip in production and x-forwarded-for elsewhere. Only list a
# header your proxy is known to overwrite; a header a client can set is a
# rate-limit bypass.
IP_ADDRESS_HEADERS=""

# Auth rate limiting. Unset means on in production, off in development.
# Set to "false" only for test runs that sign in repeatedly.
RATE_LIMIT_ENABLED=""

# Payments. Must be "reevit" in production; the app refuses to boot otherwise.
# "mock" marks orders PAID without charging anyone.
STORE_PAYMENT_PROVIDER="mock"
# Only set this in test builds that must reach the mock provider with
# NODE_ENV=production, such as the Playwright suite.
ALLOW_MOCK_PAYMENTS=""
# ... for Github
GITHUB_CLIENT_ID="YOUR_GITHUB_CLIENT_ID"
GITHUB_CLIENT_SECRET="YOUR_GITHUB_CLIENT_SECRET"
# ... for Google
GOOGLE_CLIENT_ID="YOUR_GOOGLE_CLIENT_ID"
GOOGLE_CLIENT_SECRET="YOUR_GOOGLE_CLIENT_SECRET"

# Mails
MAIL_FROM="noreply@example.com"
MAIL_PROVIDER="console"
# ... with nodemailer
MAIL_HOST=""
MAIL_PORT=""
MAIL_USER=""
MAIL_PASS=""
# ... with Plunk
PLUNK_API_KEY=""
# ... with Resend
RESEND_API_KEY=""
# ... with Postmark
POSTMARK_SERVER_TOKEN=""
# ... with Mailgun
MAILGUN_API_KEY=""
MAILGUN_DOMAIN=""

# Store payments (Reevit) — Ghana GHS / mobile money + card
STORE_PAYMENT_PROVIDER="reevit"
REEVIT_API_KEY=""
REEVIT_ORG_ID=""
REEVIT_WEBHOOK_SECRET=""
REEVIT_MODE="test"
NEXT_PUBLIC_REEVIT_CHECKOUT_KEY=""

# Payments
# ... with Lemonsqueezy
LEMONSQUEEZY_API_KEY=""
LEMONSQUEEZY_WEBHOOK_SECRET=""
LEMONSQUEEZY_STORE_ID=""
# ... with Stripe
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
# ... with Creem
CREEM_API_KEY=""
CREEM_WEBHOOK_SECRET=""
# ... with Polar
POLAR_ACCESS_TOKEN=""
POLAR_WEBHOOK_SECRET=""
# ... with DodoPayments
DODO_PAYMENTS_API_KEY=""

# Product price ids
PRICE_ID_PRO_MONTHLY="price_asdf1234"
PRICE_ID_PRO_YEARLY="price_asdf1234"
PRICE_ID_LIFETIME="price_asdf1234"

# Analytics
# ... for Pirsch
NEXT_PUBLIC_PIRSCH_CODE=""
# ... for Plausible
NEXT_PUBLIC_PLAUSIBLE_URL=""
# ... for Mixpanel
NEXT_PUBLIC_MIXPANEL_TOKEN=""
# ... for Google Analytics
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=""

# Storage
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_ENDPOINT=""
S3_REGION=""
NEXT_PUBLIC_AVATARS_BUCKET_NAME="avatars"
NEXT_PUBLIC_PRODUCTS_BUCKET_NAME="products"
NEXT_PUBLIC_STORAGE_URL=""
# For local development with Docker Compose (MinIO):
# S3_ACCESS_KEY_ID="minioadmin"
# S3_SECRET_ACCESS_KEY="minioadmin"
# S3_ENDPOINT="http://localhost:9000"
# S3_REGION="us-east-1"
# NEXT_PUBLIC_STORAGE_URL="http://localhost:9000"

# Turso (libSQL), created for a possible move off PostgreSQL. Nothing reads
# these yet: the Prisma schema and queries are still PostgreSQL, so DATABASE_URL
# is the connection the apps actually use.
TURSO_DEV_DATABASE_URL="libsql://<db>-<org>.turso.io"
TURSO_DEV_AUTH_TOKEN=""
TURSO_PROD_DATABASE_URL="libsql://<db>-<org>.turso.io"
TURSO_PROD_AUTH_TOKEN=""
